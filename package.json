    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "^4.0.5",
    "vitest-browser-svelte": "^2.0.1"
  },
  "dependencies": {
    "@threlte/core": "^8.2.1",
    "@threlte/extras": "^9.6.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
