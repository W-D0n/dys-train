    "@playwright/test": "^1.56.1",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.47.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/bun": "latest",
    "@types/node": "^22",
    "@types/three": "^0.181.0",
    "@vitest/browser-playwright": "^4.0.5",
    "autoprefixer": "^10.4.21",
    "bits-ui": "^2.11.0",
    "eslint": "^9.38.0",
